/*
 * ===================================================
 *  Process Reads Pipeline - Nextflow configuration
 * ===================================================
 * Short-read (CUT&Tag / ChIPseq / ATACseq / RNAseq) processing pipeline.
 * All processes run inside an Apptainer container.
 * Use -profile standard|slurm to select the execution environment.
 */

manifest {
    name            = 'process-reads-pipeline'
    author          = 'Eric Arezza'
    description     = 'Process Illumina short reads for CUT&Tag, ChIPseq, ATACseq and RNAseq'
    mainScript      = 'test.nf'
    version         = '2.0'
    nextflowVersion = '!>=24.04.0'
}

// ---------------------------------------------------------------------------
// Pipeline parameters (all overridable at runtime with --paramName)
// ---------------------------------------------------------------------------
params {
    // Inputs
    target          = null                 // path to directory of target fastq.gz reads (required)
    control         = ''                   // path to directory of control fastq.gz reads (optional)
    spikein         = ''                   // non-empty flag to enable spike-in normalization
    reads_type      = 'paired'             // 'paired' or 'single'
    pretrimmed      = false                // skip CUTADAPT if reads are already trimmed
    merge           = false                // single-end: process each fastq.gz in a sample directory as its own library, then merge their final BAMs (bigwigs for each file and the merged BAM)

    // Reference genomes / indexes (bowtie2/hisat2 index basename, no extension)
    assembly        = 'mm10'               // 'mm10', 'hg38', or 'rn6' (used to look up effective genome size)
    genome_index    = null                 // required
    ecoli_index     = ''                   // optional carry-over/spike-normalization index
    spikein_index   = ''                   // optional spike-in index
    length          = 50                   // read length, used for effective genome size lookup

    // Assay / trimming
    assay           = 'cutntag'            // 'cutntag', 'chipseq', 'atacseq', 'rnaseq', or other
    trim_adapters   = true
    qctrim          = false
    polyAtrim       = false
    stranded        = false

    // Alignment / filtering
    mapq            = 10
    sort_bam_order  = 'coordinate'
    normalize_by    = 'RPGC'

    // Read group metadata
    rg_id           = null                 // default: each sample's reads directory name
    rg_sm           = null                 // default: rg_id
    rg_pl           = 'ILLUMINA'
    rg_lb           = null                 // default: reads_type
    rg_pu           = 'illumina'

    // Peak calling
    macs_qvalue     = 0.05
    seacr_threshold = 0.01
    gopeaks_pvalue  = 0.05
    // Genrich (ATAC mode -j is used automatically with --assay atacseq)
    genrich_pvalue      = 0.01             // max p-value (-p); ignored when genrich_qvalue is set
    genrich_qvalue      = null             // max q-value (-q); overrides genrich_pvalue when set
    genrich_min_auc     = 200              // min area under the curve of a peak (-a)
    genrich_max_gap     = 100              // max distance between significant sites joined into one peak (-g)
    genrich_extsize     = 200              // single-end, non-ATAC: extend reads to this fragment size (-w)
    genrich_exclude_chr = 'chrM'           // comma-separated chromosomes to ignore (-e); '' for none

    // Optional files
    blacklist       = ''
    multiqc_config  = ''

    // Apptainer / container
    container_image = "${System.getenv('HOME')}/projects/def-jdilwort/DATA/apptainers/dilworthlab.sif"
    apptainer_binds = "${System.getenv('HOME')}/projects/def-jdilwort/Reference_Files/"   // comma-separated list of extra bind paths

    // SLURM
    slurm_partition = ''
    slurm_account   = ''
    slurm_queue_size = 50
    small_tasks_local = false              // slurm profile: run tiny steps (md5, scale factors, FRiP, MultiQC) inside
                                           // the Nextflow job instead of queueing each as a SLURM job (see profile)

    // Resource ceilings (cap every per-process request).
    // Unset = automatic: with -profile standard inside a SLURM job, the job's
    // own CPUs and memory (minus 2 GB for Nextflow itself); otherwise 16 / 64.GB.
    max_cpus        = null
    max_memory      = null
    max_time        = '24.h'
    // -profile standard inside a SLURM job stops at startup if the job has
    // less memory than this (all tasks share the one allocation)
    min_memory      = '16.GB'

    // Output / housekeeping
    outdir          = null                 // default: params.target (reports go to <outdir>/pipeline_info)
    cleanup         = true
    publish_mode    = 'copy'

    // Stamp for report/trace filenames (strict config syntax does not allow
    // script variables, so it lives here; evaluated once per run)
    run_timestamp   = new Date().format('yyyyMMdd-HHmmss')
}

// Note: defaults that depend on other params (outdir, rg_*) are resolved
// where they are used, not by reassigning params here - with the strict
// syntax parser in Nextflow 25.10, such reassignments run before the
// command-line values are applied and would yield null.

// Params have no declared type, so the editor's type checker sees them as
// unknown (`?`). Where a param feeds a conditional or a method call below it
// is cast explicitly (`as String` / `as Integer`) to keep the types consistent.

// ---------------------------------------------------------------------------
// Reports
// (the trace's name/tag/status/start/workdir fields are also read at the end
//  of the run to write each sample's QC/<sample>_commands.txt - keep them)
// ---------------------------------------------------------------------------
report   { enabled = true; file = "${(params.outdir as String) ?: (params.target as String) ?: '.'}/pipeline_info/nf-report_${params.run_timestamp}.html";   overwrite = true }
dag      { enabled = true; file = "${(params.outdir as String) ?: (params.target as String) ?: '.'}/pipeline_info/nf-dag_${params.run_timestamp}.png";        overwrite = true }
timeline { enabled = true; file = "${(params.outdir as String) ?: (params.target as String) ?: '.'}/pipeline_info/nf-timeline_${params.run_timestamp}.html";  overwrite = true }
trace    { enabled = true; file = "${(params.outdir as String) ?: (params.target as String) ?: '.'}/pipeline_info/nf-trace_${params.run_timestamp}.txt";      overwrite = true; fields = 'task_id,hash,native_id,process,name,tag,status,exit,attempt,cpus,%cpu,memory,%mem,rss,peak_rss,peak_vmem,rchar,wchar,duration,realtime,submit,start,complete,workdir' }

// ---------------------------------------------------------------------------
// Container engine - Apptainer is used in every profile
// ---------------------------------------------------------------------------
apptainer {
    enabled    = true
    autoMounts = true
    // An empty `--apptainer_binds ''` on the command line arrives as boolean
    // true (text "true" once cast) - filtered out below, meaning no binds.
    runOptions = (params.apptainer_binds as String)
        .tokenize(',')
        .findAll { String b -> b.trim() && !(b.trim() in ['true', 'false']) }
        .collect { String b -> "--bind ${b.trim()}" }
        .join(' ')
}

// ---------------------------------------------------------------------------
// Task concurrency
// ---------------------------------------------------------------------------
// Size of Nextflow's own execution thread pool. By default it is the number of
// CPUs Java detects + 1; inside some SLURM jobs Java detects only 1 CPU, which
// let just 1-2 tasks start at a time however many CPUs the job has. Setting it
// explicitly makes parallelism depend only on the CPU/memory limits below.
// (The editor may flag this option as unrecognised; Nextflow does use it -
// it is the config form of `nextflow run -pool-size`.)
poolSize = 64

// ---------------------------------------------------------------------------
// Global process defaults
// ---------------------------------------------------------------------------
process {
    container      = "file://${params.container_image}"
    cache          = 'lenient'
    errorStrategy  = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries     = 2

    // Per-label requests; profiles below only change *where* these run.
    // Sized from measured runs (trace %cpu / peak_rss: RNA-seq paired, RNA-seq
    // single-end --merge, CUT&Tag paired + control + spike-in), with headroom.
    // Anything killed for memory is retried with double the memory.

    // Light, single-threaded
    withLabel: 'md5sum_check|scale_factor' {
        cpus   = 1
        memory = { 1.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: 'multiqc_report|seacr_peaks|seacr_peaks_control' {      // peak < 0.5 GB
        cpus   = 1
        memory = { 2.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    // MACS3: narrow + broad side by side (measured 1.7-1.9 CPUs, < 0.5 GB)
    withLabel: 'macs_peaks|macs_peaks_control' {
        cpus   = 2
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // GoPeaks: multi-threaded Go, uses 15-25 GB (genome-wide bins) regardless of depth
    withLabel: 'gopeaks_peaks|gopeaks_peaks_control' {
        cpus   = 3
        memory = { 32.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    // FastQC - CPUs set per task in modules.nf (one thread per file); ~1 GB
    withLabel: 'fastqc_check' {
        memory = { 2.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    // FRiP - samtools counting
    withLabel: 'frip' {
        cpus   = 2
        memory = { 2.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    // Adapter trimming (one pass, compressed output)
    withLabel: 'cutadapt' {
        cpus   = 4
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // Alignment + coordinate sort in one pipe - the longest step on the main
    // reference, so it gets the most CPUs (measured 7.3-7.9 of 8 used; peak
    // 7.4 GB hisat2 / 6.8 GB bowtie2). CPUs stay fixed on retry.
    withLabel: 'bowtie2|hisat2' {
        cpus   = 12
        memory = { 12.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // samtools filter / name-sort - multi-threaded, little memory (peak < 1.5 GB)
    withLabel: 'qfilter_bam|name_sort_bam' {
        cpus   = 4
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // Picard MarkDuplicates - Java heap is 85% of this (javaHeap in modules.nf);
    // measured peak 7.3 GB with an 8 GB request
    withLabel: 'prefilter_qc|deduplicate_bam' {
        cpus   = 2
        memory = { 8.GB  * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    // Picard MergeSamFiles (measured 1.5 GB)
    withLabel: 'merge_bams' {
        cpus   = 2
        memory = { 4.GB  * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    // Genrich - single-threaded, holds all alignments in memory (7.7 GB on small data)
    withLabel: 'genrich_peaks|genrich_peaks_control' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // deepTools coverage tracks - scale well (6.6 of 8 CPUs), little memory (< 1 GB)
    withLabel: 'bigwig|bedgraph' {
        cpus   = 8
        memory = { 2.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: 'bamcompare' {                                          // peak 1.7 GB
        cpus   = 8
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // Off-target alignments are fast and small: fewer CPUs, less memory, so
    // they don't hold back the main alignments (measured 14-25 s; 0.1 / 3.9 GB)
    withName: 'ALIGN_ECOLI' {
        cpus   = 4
        memory = { 2.GB  * task.attempt }
    }
    withName: 'ALIGN_SPIKEIN' {
        cpus   = 4
        memory = { 6.GB  * task.attempt }
    }

    // Caps every request above to what the machine / cluster can provide
    // (e.g. alignment asking for 16 CPUs on retry is trimmed to max_cpus).
    resourceLimits = [
        cpus:   (params.max_cpus   as Integer) ?: 16,
        memory: ((params.max_memory as String) ?: '64.GB') as MemoryUnit,
        time:   (params.max_time as String) as Duration
    ]
}

// ---------------------------------------------------------------------------
// Execution profiles
// ---------------------------------------------------------------------------
profiles {

    // Everything runs on the current machine. Inside a SLURM job (salloc /
    // sbatch) the limits default to that job's allocation, so tasks are only
    // started in parallel as far as the allocation allows; --max_cpus /
    // --max_memory override. SLURM_MEM_PER_NODE comes from --mem,
    // SLURM_MEM_PER_CPU from --mem-per-cpu (both in MB); 2 GB is left for
    // Nextflow itself.
    standard {
        process.executor = 'local'
        executor {
            name   = 'local'
            // How many tasks may run at once (CPU and memory limits below still
            // apply). Left unset, Nextflow uses the number of CPUs *it* detects,
            // which can be 1 inside a SLURM job even when the job has many CPUs -
            // every step then runs one after another.
            queueSize = 1000
            cpus   = (params.max_cpus as Integer) ?: (System.getenv('SLURM_CPUS_PER_TASK') ?: System.getenv('SLURM_CPUS_ON_NODE') ?: '16').toInteger()
            memory = ((params.max_memory as String) ?:
                        (System.getenv('SLURM_MEM_PER_NODE') ? "${Math.max(System.getenv('SLURM_MEM_PER_NODE').toLong() - 2048, 1024L)} MB" :
                         System.getenv('SLURM_MEM_PER_CPU')  ? "${Math.max(System.getenv('SLURM_MEM_PER_CPU').toLong() * (System.getenv('SLURM_CPUS_PER_TASK') ?: System.getenv('SLURM_CPUS_ON_NODE') ?: '1').toLong() - 2048, 1024L)} MB" :
                         '64.GB')) as MemoryUnit
        }
        process.resourceLimits = [
            // same values as executor.cpus / executor.memory above
            cpus:   (params.max_cpus as Integer) ?: (System.getenv('SLURM_CPUS_PER_TASK') ?: System.getenv('SLURM_CPUS_ON_NODE') ?: '16').toInteger(),
            memory: ((params.max_memory as String) ?:
                        (System.getenv('SLURM_MEM_PER_NODE') ? "${Math.max(System.getenv('SLURM_MEM_PER_NODE').toLong() - 2048, 1024L)} MB" :
                         System.getenv('SLURM_MEM_PER_CPU')  ? "${Math.max(System.getenv('SLURM_MEM_PER_CPU').toLong() * (System.getenv('SLURM_CPUS_PER_TASK') ?: System.getenv('SLURM_CPUS_ON_NODE') ?: '1').toLong() - 2048, 1024L)} MB" :
                         '64.GB')) as MemoryUnit,
            time:   (params.max_time as String) as Duration
        ]
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = (params.slurm_partition as String) ?: null
        process.clusterOptions = (params.slurm_account as String) ? "--account=${params.slurm_account}" : null
        // Let SLURM's own scratch handling manage per-job temp space
        process.scratch = true
        // --small_tasks_local: steps that take seconds to minutes run inside the
        // Nextflow job itself rather than each waiting in the SLURM queue. Only
        // use when Nextflow runs inside an sbatch job; they then share that job's
        // CPUs and memory (capped below), e.g. sbatch --cpus-per-task=4 --mem=16G.
        process {
            withLabel: 'md5sum_check|scale_factor|frip|multiqc_report' {
                executor = params.small_tasks_local ? 'local' : 'slurm'
            }
        }
        executor {
            // cpus / memory: limits for steps run inside the Nextflow job (local executor only)
            cpus              = (System.getenv('SLURM_CPUS_PER_TASK') ?: '2').toInteger()
            memory            = System.getenv('SLURM_MEM_PER_NODE') ? "${Math.max(System.getenv('SLURM_MEM_PER_NODE').toLong() - 2048, 1024L)} MB" as MemoryUnit : 4.GB
            queueSize         = params.slurm_queue_size as Integer
            // checks for finished tasks (files on disk, cheap); squeue is polled
            // separately every queueStatInterval
            pollInterval      = 10.s
            queueStatInterval = 60.s
            submitRateLimit   = '10/1sec'
        }
    }
}
